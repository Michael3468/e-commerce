# ============================================================
# Переменные окружения frontend
# Скопируйте файл в .env.local и подставьте свои значения.
# ============================================================

# Публичный адрес backend API (для запросов из браузера).
# Локально: http://localhost:8000
# В docker-compose сети используйте публичный адрес образа backend,
# если он проброшен наружу, либо домен вашего окружения.
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Адрес backend для серверных (SSR) вызовов из Next.js.
# Внутри docker-сети backend доступен по имени сервиса "backend",
# поэтому здесь указываем внутренний адрес. Локально совпадает с публичным.
INTERNAL_API_URL=http://backend:8000/api

# Сайт-заголовок приложения
NEXT_PUBLIC_SITE_NAME=E-Commerce