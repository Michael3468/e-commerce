{
  "name": "e-commerce",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "docker compose up --build",
    "frontend:test": "npm --prefix frontend test",
    "frontend:typecheck": "npm --prefix frontend run typecheck",
    "frontend:lint": "npm --prefix frontend run lint",
    "backend:test": "docker compose exec -T backend pytest -v",
    "tests": "clear && npm run frontend:typecheck && npm run frontend:lint && npm run frontend:test && npm run backend:test",
    "commit": "clear && npm run tests && git status && git-cz",
    "prepare": "husky",
    "lint-staged": "lint-staged"
  },
  "lint-staged": {
    "frontend/**/*.{js,jsx,ts,tsx}": [
      "npm --prefix frontend run test -- --run --passWithNoTests",
      "npm run frontend:typecheck",
      "npm run frontend:lint",
      "npm run backend:test"
    ],
    "frontend/**/*": [
      "bash -c 'npm --prefix frontend run typecheck'"
    ]
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "devDependencies": {
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1"
  }
}
